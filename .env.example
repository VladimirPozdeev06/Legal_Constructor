# Скопируй этот файл в .env и заполни значения

# ── Django ────────────────────────────────────────────────
# Секретный ключ. Локально можно любой; на хостинге — длинный случайный.
DJANGO_SECRET_KEY=замени-на-свой-секретный-ключ
# DEBUG: локально True, на хостинге обязательно False
DJANGO_DEBUG=True
# Разрешённые хосты через запятую (локально не трогать; на хостинге — домен сайта)
ALLOWED_HOSTS=localhost,127.0.0.1
# Доверенные origin для CSRF на хостинге, напр.: https://legal-constructor.onrender.com
CSRF_TRUSTED_ORIGINS=

# ── AI-помощник (OpenRouter) ──────────────────────────────
# Ключ с openrouter.ai. БЕЗ него AI отвечает заглушкой.
OPENAI_API_KEY=sk-or-твой_ключ_здесь
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Лимиты запросов к AI
AI_DAILY_LLM_LIMIT_AUTH=15
AI_GUEST_LLM_LIMIT=1
